# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Database (must match the log-agent postgres service) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=log_user
DB_PASSWORD=changeme
DB_NAME=api_log_db

# --- Server ---
SERVER_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- SSO configuration (feature 003) ---
# Fallback client secret used when no provider secret has been saved via the
# admin UI/API yet. Leave blank until a real IdP secret is set.
SSO_CLIENT_SECRET=
# Shared token required in the X-Admin-Token header to write/validate SSO
# config, mappings, or delete a mapping. Generate a real random value —
# do not use this placeholder in any deployed environment.
ADMIN_API_TOKEN=changeme-admin-token
