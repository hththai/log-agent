# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Database (must match the log-agent postgres service) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=log_user
DB_PASSWORD=changeme
DB_NAME=api_log_db

# --- Server ---
SERVER_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- SSO configuration (feature 003) ---
# Fallback client secret used when no provider secret has been saved via the
# admin UI/API yet. Leave blank until a real IdP secret is set.
SSO_CLIENT_SECRET=
# Shared token required in the X-Admin-Token header to write/validate SSO
# config, mappings, or delete a mapping. Generate a real random value —
# do not use this placeholder in any deployed environment.
ADMIN_API_TOKEN=changeme-admin-token
# Signs the server-side session cookie (SessionMiddleware) used by the
# /sso/authorize -> /sso/callback redirect sign-in flow and by Authlib for
# CSRF state/OIDC nonce storage. Generate a real random value — do not use
# this placeholder in any deployed environment.
SESSION_SECRET_KEY=changeme-session-secret
# Base URL of the client SPA. GET /sso/callback redirects the browser back
# here after sign-in — it must be absolute since the browser lands on this
# API's own origin first (the provider's configured redirect_uri).
CLIENT_BASE_URL=http://localhost:3000
